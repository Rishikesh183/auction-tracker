# Copy to .env and fill in. Never commit .env.

# Supabase (Project settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Clerk (https://dashboard.clerk.com -> API keys). Empty = password fallback login.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Admin emails (comma-separated, must be verified in Clerk)
ADMIN_EMAILS=cricmawa@gmail.com,rishikeshdevarashetty@gmail.com

# Optional: password fallback (used only while Clerk keys are empty)
# ADMIN_USERNAME=
# ADMIN_PASSWORD=
# ADMIN_SESSION_SECRET=

# Public site URL (canonical links, sitemap, share images), e.g. https://ipl.cricmawa.com
NEXT_PUBLIC_SITE_URL=
